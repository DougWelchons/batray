<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title>Batray – Bid Tracker</title>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Batray">

    <% icon_file = Rails.env.production? ? "icon.png" : "icon-dev.png" %>
    <link rel="icon" href="/<%= icon_file %>?v=6" type="image/png">
    <link rel="apple-touch-icon" href="/<%= icon_file %>?v=6">

    <%= stylesheet_link_tag :app %>
  </head>

  <body class="app-body">
    <div class="app-main app-main--with-sidebar">
      <%= yield %>
    </div>
  </body>
</html>
