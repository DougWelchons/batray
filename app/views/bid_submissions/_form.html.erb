<%= form_with(model: [@project, bid_submission], class: "form") do |f| %>
  <% if bid_submission.errors.any? %>
    <div class="form__errors" role="alert">
      <h3><%= pluralize(bid_submission.errors.count, "error") %> prevented this bid from being saved:</h3>
      <ul>
        <% bid_submission.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :contractor_id, "General Contractor", class: "form__label" %>
      <%= f.select :contractor_id,
        options_for_select(Contractor.order(:name).map { |c| [c.name, c.id] }, bid_submission.contractor_id),
        { include_blank: "Select GC..." },
        class: "form__select", required: true %>
    </div>

    <div class="form__field">
      <%= f.label :status, class: "form__label" %>
      <%= f.select :status,
        options_for_select(BidSubmission.statuses.keys.map { |s| [s.humanize, s] }, bid_submission.status || "drafting"),
        {},
        class: "form__select" %>
    </div>
  </div>

  <div class="form__row form__row--cols-3">
    <div class="form__field">
      <%= f.label :bid_submitted_at, "Bid Submitted", class: "form__label" %>
      <%= f.date_field :bid_submitted_at, class: "form__input",
        value: bid_submission.bid_submitted_at&.to_date %>
    </div>
    <div class="form__field">
      <%= f.label :bid_due_at, "Bid Due", class: "form__label" %>
      <%= f.date_field :bid_due_at, class: "form__input",
        value: bid_submission.bid_due_at&.to_date %>
    </div>
    <div class="form__field">
      <%= f.label :award_decision_at, "Award Decision", class: "form__label" %>
      <%= f.date_field :award_decision_at, class: "form__input",
        value: bid_submission.award_decision_at&.to_date %>
    </div>
  </div>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :submitted_value, class: "form__label" %>
      <%= f.number_field :submitted_value, class: "form__input",
        placeholder: "0.00", step: "0.01", min: "0" %>
    </div>
    <div class="form__field">
      <%= f.label :awarded_value, class: "form__label" %>
      <%= f.number_field :awarded_value, class: "form__input",
        placeholder: "0.00", step: "0.01", min: "0" %>
    </div>
  </div>

  <div class="form__row form__row--cols-3">
    <div class="form__field">
      <%= f.label :probability_percent, "Probability %", class: "form__label" %>
      <%= f.number_field :probability_percent, class: "form__input",
        min: 0, max: 100, step: 1 %>
    </div>
    <div class="form__field form__field--checkbox-group">
      <%= f.label :included_fire_alarm, class: "form__checkbox-label" do %>
        <%= f.check_box :included_fire_alarm, class: "form__checkbox" %>
        Fire Alarm
      <% end %>
    </div>
    <div class="form__field form__field--checkbox-group">
      <%= f.label :included_low_voltage, class: "form__checkbox-label" do %>
        <%= f.check_box :included_low_voltage, class: "form__checkbox" %>
        Low Voltage
      <% end %>
    </div>
  </div>

  <div class="form__row">
    <div class="form__field form__field--wide">
      <%= f.label :reason_lost, "Reason Lost", class: "form__label" %>
      <%= f.text_field :reason_lost, class: "form__input", placeholder: "If lost, reason..." %>
    </div>
  </div>

  <div class="form__row">
    <div class="form__field form__field--wide">
      <%= f.label :notes, class: "form__label" %>
      <%= f.text_area :notes, class: "form__textarea", rows: 3 %>
    </div>
  </div>

  <div class="form__actions">
    <%= f.submit bid_submission.persisted? ? "Update Bid" : "Add Bid", class: "btn btn--primary" %>
    <%= link_to "Cancel", project_path(@project), class: "btn btn--ghost" %>
  </div>
<% end %>
