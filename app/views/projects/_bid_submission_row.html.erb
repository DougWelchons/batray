<div class="bid-row" data-nested-form-target="row">
  <%= bf.hidden_field :_destroy, data: { "nested-form-target": "destroyField" } %>

  <div class="form__field">
    <%= bf.select :contractor_id,
      options_for_select(contractors.map { |c| [c.name, c.id] }, bf.object.contractor_id),
      { include_blank: "Select GC..." },
      class: "form__select" %>
  </div>

  <div class="form__field">
    <%= bf.date_field :bid_due_at, class: "form__input form__input--sm",
      value: bf.object.bid_due_at&.to_date %>
  </div>

  <div class="form__field">
    <%= bf.number_field :submitted_value, class: "form__input form__input--sm",
      placeholder: "0.00", step: "0.01", min: "0" %>
  </div>

  <div class="form__field form__field--center">
    <%= bf.check_box :included_fire_alarm, class: "form__checkbox" %>
  </div>

  <div class="form__field form__field--center">
    <%= bf.check_box :included_low_voltage, class: "form__checkbox" %>
  </div>

  <div class="form__field">
    <%= bf.select :status,
      options_for_select(BidSubmission.statuses.keys.map { |s| [s.humanize, s] }, bf.object.status || "drafting"),
      {},
      class: "form__select" %>
  </div>

  <div class="form__field form__field--center">
    <button type="button" class="btn btn--danger btn--sm btn--icon"
      data-action="click->nested-form#removeRow"
      aria-label="Remove row">
      &times;
    </button>
  </div>
</div>
