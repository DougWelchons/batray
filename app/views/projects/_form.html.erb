<%= form_with(model: project, class: "form") do |f| %>
  <% if project.errors.any? %>
    <div class="form__errors" role="alert">
      <h3><%= pluralize(project.errors.count, "error") %> prevented this project from being saved:</h3>
      <ul>
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__section">
    <h2 class="form__section-title">Project Information</h2>

    <div class="form__row">
      <div class="form__field form__field--wide">
        <%= f.label :name, "Project Name", class: "form__label" %>
        <%= f.text_field :name, class: "form__input", placeholder: "Enter project name", required: true %>
      </div>
    </div>

    <div class="form__row form__row--cols-3">
      <div class="form__field">
        <%= f.label :location, class: "form__label" %>
        <%= f.text_field :location, class: "form__input", placeholder: "City, State" %>
      </div>
      <div class="form__field">
        <%= f.label :project_type, "Type", class: "form__label" %>
        <%= f.text_field :project_type, class: "form__input", placeholder: "Commercial, Industrial..." %>
      </div>
      <div class="form__field">
        <%= f.label :estimated_start_date, "Est. Start Date", class: "form__label" %>
        <%= f.date_field :estimated_start_date, class: "form__input" %>
      </div>
    </div>
  </div>

  <div class="form__section" data-controller="nested-form">
    <div class="form__section-header">
      <h2 class="form__section-title">GC Bid Submissions</h2>
      <button type="button" class="btn btn--secondary btn--sm" data-action="click->nested-form#addRow">
        + Add GC
      </button>
    </div>

    <div class="bid-submissions-table">
      <div class="bid-submissions-table__header">
        <span>General Contractor</span>
        <span>Bid Due Date</span>
        <span>Submitted Value</span>
        <span>FA</span>
        <span>LV</span>
        <span>Status</span>
        <span></span>
      </div>

      <div data-nested-form-target="rowsContainer" id="bid-submission-rows">
        <%= f.fields_for :bid_submissions do |bf| %>
          <%= render "projects/bid_submission_row", bf: bf, contractors: @contractors, users: @users %>
        <% end %>
      </div>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :bid_submissions, BidSubmission.new, child_index: "NEW_RECORD" do |bf| %>
        <%= render "projects/bid_submission_row", bf: bf, contractors: @contractors, users: @users %>
      <% end %>
    </template>
  </div>

  <div class="form__actions">
    <%= f.submit project.persisted? ? "Update Project" : "Create Project", class: "btn btn--primary" %>
    <%= link_to "Cancel", project.persisted? ? project_path(project) : projects_path, class: "btn btn--ghost" %>
  </div>
<% end %>
