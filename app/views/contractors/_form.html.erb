<%= form_with(model: contractor, class: "form") do |f| %>
  <% if contractor.errors.any? %>
    <div class="form__errors" role="alert">
      <h3><%= pluralize(contractor.errors.count, "error") %> prevented this from being saved:</h3>
      <ul>
        <% contractor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :name, "Company Name", class: "form__label" %>
      <%= f.text_field :name, class: "form__input", required: true %>
    </div>
    <div class="form__field">
      <%= f.label :contact_name, "Contact Name", class: "form__label" %>
      <%= f.text_field :contact_name, class: "form__input" %>
    </div>
  </div>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :email, class: "form__label" %>
      <%= f.email_field :email, class: "form__input" %>
    </div>
    <div class="form__field">
      <%= f.label :phone, class: "form__label" %>
      <%= f.telephone_field :phone, class: "form__input" %>
    </div>
  </div>

  <div class="form__row">
    <div class="form__field form__field--wide">
      <%= f.label :notes, class: "form__label" %>
      <%= f.text_area :notes, class: "form__textarea", rows: 3 %>
    </div>
  </div>

  <div class="form__actions">
    <%= f.submit contractor.persisted? ? "Update Contractor" : "Create Contractor", class: "btn btn--primary" %>
    <%= link_to "Cancel", contractor.persisted? ? contractor_path(contractor) : contractors_path, class: "btn btn--ghost" %>
  </div>
<% end %>
