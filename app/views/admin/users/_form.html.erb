<%= form_with(model: [:admin, user], class: "form") do |f| %>
  <% if user.errors.any? %>
    <div class="form__errors" role="alert">
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :name, class: "form__label" %>
      <%= f.text_field :name, class: "form__input", required: true %>
    </div>
    <div class="form__field">
      <%= f.label :email, class: "form__label" %>
      <%= f.email_field :email, class: "form__input", required: true %>
    </div>
  </div>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :role, class: "form__label" %>
      <%= f.select :role,
        options_for_select(User.roles.keys.map { |r| [r.humanize, r] }, user.role),
        {},
        class: "form__select" %>
    </div>
  </div>

  <div class="form__row form__row--cols-2">
    <div class="form__field">
      <%= f.label :password, class: "form__label" %>
      <%= f.password_field :password, class: "form__input",
        placeholder: user.persisted? ? "Leave blank to keep unchanged" : "" %>
    </div>
    <div class="form__field">
      <%= f.label :password_confirmation, "Confirm Password", class: "form__label" %>
      <%= f.password_field :password_confirmation, class: "form__input" %>
    </div>
  </div>

  <div class="form__actions">
    <%= f.submit user.persisted? ? "Update User" : "Create User", class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn--ghost" %>
  </div>
<% end %>
